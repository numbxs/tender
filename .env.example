# ─── Arc (settlement) ────────────────────────────────────────────────
# VERIFIED against the live RPC on day 0. USDC is the NATIVE GAS TOKEN --
# escrow settles in native value, there is no approve() step.
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
# Read-only ERC-20 view of the native token. Do not assume approve/transferFrom.
ARC_USDC_PRECOMPILE=0x3600000000000000000000000000000000000000
ARC_REGISTRY_ADDRESS=
ARC_ESCROW_ADDRESS=
# Deployer key for packages/contracts scripts. Testnet only, never a real key.
ARC_DEPLOYER_PRIVATE_KEY=

# ─── ENS (identity) ──────────────────────────────────────────────────
SEPOLIA_RPC_URL=
ENS_PARENT_NAME=tender.eth
ENS_REGISTRY_ADDRESS=

# ─── Privy (onboarding) ──────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ─── World (risk gate) ───────────────────────────────────────────────
NEXT_PUBLIC_WORLD_APP_ID=
WORLD_SELFIE_CHECK_ACTION=
WORLD_API_KEY=

# ─── Hedera (metering + claims) ──────────────────────────────────────
HEDERA_NETWORK=testnet
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=

# ─── x402 (bid metering) ─────────────────────────────────────────────
# Metering runs on Hedera -- its track requires the gated service there.
X402_NETWORK=hedera-testnet
X402_PAY_TO_ADDRESS=
X402_BID_PRICE_USDC=0.01
GATEWAY_URL=http://localhost:8787

# ─── Chainlink (private terms) ───────────────────────────────────────
CRE_WORKFLOW_ID=
CRE_TEE_HANDLER_URL=

# ─── Uniswap (payout swap) ───────────────────────────────────────────
UNISWAP_API_KEY=

# ─── Agent ───────────────────────────────────────────────────────────
AGENT_PRIVATE_KEY=

# ─── Bazantic (distribution) ─────────────────────────────────────────
# Account is registered (see team notes for which address).
# The username MUST appear in the submission -- see SPEC §12.
BAZANTIC_USERNAME=
BAZANTIC_API_KEY=

# Demo: Arc faucet gives 20 USDC/2h, so a 100 USDC release is unfundable and the
# Selfie + Ledger gate would never fire on camera. Set low when recording.
NEXT_PUBLIC_RELEASE_GATE_THRESHOLD_USDC=1
